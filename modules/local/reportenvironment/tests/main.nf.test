nextflow_process {

    name "Test Process REPORTENVIRONMENT"
    script "../main.nf"
    process "REPORTENVIRONMENT"

    tag "modules"
    tag "modules_local"
    tag "reportenvironment"

    test("collect report runtime environment") {

        when {
            process {
                """
                input[0] = 'community.wave.seqera.io/library/jupyter_matplotlib_papermill_quarto_r-rmarkdown:6d15193ce3dfc665'
                """
            }
        }

        then {
            assertAll {
                { assert process.success }
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["multiqc_table", "multiqc_r_session"])).match() }
            }
        }
    }
}
