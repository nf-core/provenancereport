params {
    input = "${projectDir}/tests/assets/samplesheet_rds.csv"
    notebook = "${projectDir}/tests/assets/external_rds_report.qmd"
}

process {
    withName: 'QUARTO_NOTEBOOK' {
        container = { workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container ?
            'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/8b/8bab99a5f6d1596a6d1ed29fb9e3afb3be80e84b417e1b295f7d9a1bf1ae0565/data' :
            'community.wave.seqera.io/library/bioconductor-biobase_bioconductor-biocgenerics_bioconductor-delayedarray_bioconductor-genomicranges_pruned:7163c0bd27362bdf' }
        // Explicit lock generated from environment.yml for reproducible Conda tests.
        conda = "${projectDir}/tests/assets/.conda-lock/quartonotebook_rds_linux_amd64-bd-7163c0bd27362bdf_1.txt"
    }
}
